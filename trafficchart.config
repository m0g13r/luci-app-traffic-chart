
# /etc/config/trafficchart
#
# All settings of the traffic chart. Only "backend" is active by default; every
# other option is listed with its DEFAULT value - remove the "#" to change it, e.g.
#     uci set trafficchart.global.interval='5'
#     uci commit trafficchart          # restarts the service, applies at once
# "uci show trafficchart" lists what is set. An invalid value is ignored (the
# default is used) and reported in "logread -e trafficchart".
# Restarting resets the cumulative totals; the history survives.

config trafficchart 'global'

	# --- service ---------------------------------------------------------
	# 0 = do not start the daemon at all
	option enabled '1'
	# 1 = also run trafficchart-apps (application names from netifyd, needs socat)
	option apps '1'
	# profile: balanced, low-cpu, very-low-cpu
	#  low-cpu keeps app names on while reducing poll churn and refresh rate
	option profile 'low-cpu'

	# --- shaper detection ------------------------------------------------
	# nss     NSS hardware offload (nsstbl / nssfq_codel, download shaper on nssifb)
	# generic stock sqm-scripts (cake or htb+fq_codel, download shaper on ifb4<wan>)
	# auto    nss if the nssifb device exists, else generic
	option backend 'auto'

	# --- sampling and rates ----------------------------------------------
	# seconds between two conntrack passes - the FLOOR/starting point the
	# daemon uses; see "CPU load adaptation" below for why it is not simply
	# stretched by hand for a busier box.
	#option interval '4'
	# seconds: averaging window of all rates (application / device / destination)
	#option rate_win '10'
	# seconds: history bucket length and number of buckets kept (288 x 300 s = 24 h)
	#option hist_sec '300'
	#option hist_keep '288'

	# --- history: week / month / year and persistent storage ------------------
	# The chart keeps three resolutions, each computed from the full totals:
	#   5 min buckets (hist_sec / hist_keep above)          -> "24 hours" view
	#   1 hour buckets, closed at every full local hour     -> "Week" view
	#   1 day buckets, closed at local midnight             -> "Month" and "Year" view
	# number of hourly / daily buckets kept (192 h = 8 days, 400 days)
	#option hist_hour_keep '192'
	#option hist_day_keep '400'
	# Persistent storage: directory (absolute; letters, digits, . _ - / only) the history
	# is saved to and reloaded from after a reboot. Empty = off, history only in RAM.
	# SEVERAL targets can be given, space separated, e.g. a NAS share (mounted by you, for
	# example CIFS/NFS under /mnt/nas) and a USB stick. All usable targets are written
	# (mirrors); one that is missing is retried and, when it is back, gets everything it
	# missed. After a reboot the targets are merged.
	# Three small files (history-5m/1h/1d.jsonl) per target are APPENDED to, so only the new
	# buckets are written (roughly 1 MB per day in total) - fine for flash, but a USB stick
	# or a NAS is the better place:  '/mnt/nas/traffic /mnt/sda1/trafficchart'
	# (below /etc a target is also kept by sysupgrade).
	#option persist_dir ''
	# optional, space separated: a target below one of these paths is only used while that
	# path is a mount point, e.g. '/mnt/nas /mnt/sda1'. Without it a share that is not
	# mounted (yet) would make the router create the directory on its flash, hidden again
	# as soon as the share is mounted.
	#option persist_mount ''
	# seconds between two writes to the targets (minimum 60). Data of the last period is
	# lost on a power failure; a clean stop / reboot / restart always writes everything.
	#option persist_sec '3600'
	# seconds every access to a target may take (3..120) before it is given up. A NAS that
	# hangs can therefore stall the daemon for this long at most. Mount network shares with
	# the "soft" option as well.
	#option persist_timeout '10'

	# --- CPU load adaptation ----------------------------------------------
	# This daemon runs on everything from a small home router with a handful
	# of clients to a busy CPE/hotspot with hundreds or thousands of active
	# flows, and there is no way to know which in advance - so instead of
	# asking you to guess a poll rate for hardware you may not know either,
	# it measures its own processing time each poll and adapts automatically.
	# 1 = auto-stretch the interval between polls once processing time grows
	# into a meaningful share of the cycle (and ease it back down again once
	# load drops); 0 = always use "interval" above as a fixed rate.
	#option adapt_interval '1'
	# seconds: ceiling for the auto-stretched interval
	#option interval_max '20'
	# once processing time exceeds this share of the cycle, the interval is
	# raised; eased back down again well below that share (0..1)
	#option adapt_budget '0.45'
	# how often the tooltip top-10 lists (top destinations per application,
	# top devices per destination, top applications per device) are rebuilt.
	# 0 (default) = derive it automatically from how large those internal
	# tables currently are - cheap and rebuilt every poll with a handful of
	# clients, less often once there are hundreds/thousands of entries,
	# since the rebuild itself is a full scan of the table. A positive
	# number pins it to a fixed number of polls instead (mainly for tuning).
	#option tooltip_every '2'
	# seconds: how often the neighbour table / DHCP leases / static hosts are
	# re-read (device names and MACs) and how often the LAN IPv6 GUA prefix
	# is re-detected. These used to be a fixed poll COUNT; now real elapsed
	# seconds, so they keep their meaning even while interval is adapting.
	#option hosts_refresh_sec '180'
	#option gua_refresh_sec '300'

	# --- traffic classes (shared with the SQM script nss-rk.qos) --------------
	# bytes: a WEB / P2P / BE flow above this size is shown as BULK. nss-rk.qos
	# reads the same option - restart SQM (/etc/init.d/sqm restart) after changing it.
	#option bulk_bytes '314572800'

	# --- application names (netifyd) -------------------------------------
	# path of the netifyd JSON socket ([socket] listen_path in /etc/netifyd.conf)
	#option sock '/var/run/netifyd/netifyd.sock'
	# polls a new flow waits for its netifyd label before it is booked as "[CLASS]"
	#option app_hold '3'

	# --- "Not attributed" and the link header ----------------------------
	# Bytes per packet that the shaper counts but conntrack does not (link layer
	# header). auto = measured; or a fixed number: 14 Ethernet, 18 with VLAN,
	# 22 with PPPoE, 26 with PPPoE + VLAN, 0 = no correction.
	#option l2_overhead 'auto'
	# used until l2_overhead auto has enough measurements
	#option l2_init '18'
	# header sizes the measurement is rounded down to (0 = tun/ppp device)
	#option l2_candidates '0 14 18 22 26'
	# measurement: window length (s), windows kept, windows needed, percentile
	# taken, only windows with a mean packet size below cal_max_pkt bytes and at
	# least cal_min_pkts packets count, tolerance in bytes when rounding down
	#option cal_win '30'
	#option cal_keep '60'
	#option cal_min '8'
	#option cal_pctl '25'
	#option cal_max_pkt '400'
	#option cal_min_pkts '500'
	#option cal_tol '1'
	# seconds: window of the "not attributed" rate (upload / download; the
	# download one is longer because NSS syncs big downloads in bursts)
	#option un_win '30'
	#option un_win_rx '60'

	# --- traffic of the router itself (stream proxy on the router) ----------
	# 1 = credit the router's WAN traffic of proxy streams to the LAN devices
	# that are served ("Proxy-Stream (via Router)" row); 0 = keep it on "Router"
	#option attr_totals '1'
	# 1 = show the real application name of the router flow instead
	#option attr_topapps '0'
	# port(s) of the stream proxy on the router (space separated). Only LAN ->
	# router flows to these ports count as "served by the router". Empty = every
	# port except attr_skip_ports.
	#option attr_ports '9999'
	# ports of router infrastructure (SSH, DNS, DHCP, NTP, DoT, mDNS, LuCI ...):
	# ignored unless attr_ports is empty
	#option attr_skip_ports '22 53 67 68 80 123 443 853 5353 5355'
	# seconds: window in which router traffic and delivery to a device are matched
	#option attr_win '60'
	# max. relative volume difference for a pairing (0..1); minimum volume in
	# bytes and minimum share of the router's WAN traffic of a candidate
	#option attr_tol '0.6'
	#option attr_min '262144'
	#option attr_share '0.25'
	# maximum router applications / delivered-to devices considered by attribution;
	# lower values reduce matching work, 0 keeps all candidates
	#option attr_max_apps '64'
	#option attr_max_devices '64'

	# --- memory limits ---------------------------------------------------
	# destinations kept individually. When the table is full, destinations that have been
	# idle for a while are folded into "(other)" and their slot is reused (older versions
	# used the 200 slots up for good: after some hours every new destination was "(other)").
	# The page data grows with this number, so keep it moderate.
	#option host_max '200'
	# applications kept (further ones are summed as "(other)")
	#option app_max '400'
	# entries of the tooltip tables (application x destination / destination x
	# device, device x application). When full, entries idle for
	# tbl_idle_long seconds are dropped first, then those idle for tbl_idle_short.
	#option mx_max '8000'
	#option pair_max '4096'
	#option tbl_idle_long '3600'
	#option tbl_idle_short '600'

	# --- guards (leave alone unless you see "guard:" lines in logread) ------
	# bytes: a flow first seen with more than this in ONE poll is adopted as
	# baseline instead of booked
	#option birth_max '1073741824'
	# polls a flow may be missing before its state is dropped
	#option gone_grace '5'

	# --- LuCI page (rpcd script) -----------------------------------------
	# seconds: older daemon data is reported as "stale"
	#option agg_max_age '10'
	# seconds: the page data is cached this long (collapses several open tabs)
	#option cache_ttl_sec '1'
