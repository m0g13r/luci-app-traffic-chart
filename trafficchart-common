        CAL_KEEP) CAL_KEEP="$def" ;; CAL_MIN) CAL_MIN="$def" ;; CAL_PCTL) CAL_PCTL="$def" ;;
        CAL_MAX_PKT) CAL_MAX_PKT="$def" ;; CAL_MIN_PKTS) CAL_MIN_PKTS="$def" ;; HOST_MAX) HOST_MAX="$def" ;;
        UN_WIN) UN_WIN="$def" ;; UN_WIN_RX) UN_WIN_RX="$def" ;; UN_WIN_LONG) UN_WIN_LONG="$def" ;;
        APP_MAX) APP_MAX="$def" ;; MX_MAX) MX_MAX="$def" ;; PAIR_MAX) PAIR_MAX="$def" ;;
        TBL_IDLE_LONG) TBL_IDLE_LONG="$def" ;; TBL_IDLE_SHORT) TBL_IDLE_SHORT="$def" ;; RATE_WIN) RATE_WIN="$def" ;;
        TOOLTIPS) TOOLTIPS="$def" ;; TOOLTIP_EVERY) TOOLTIP_EVERY="$def" ;;
        HOSTS_REFRESH_SEC) HOSTS_REFRESH_SEC="$def" ;; GUA_REFRESH_SEC) GUA_REFRESH_SEC="$def" ;;
        GONE_GRACE) GONE_GRACE="$def" ;; BIRTH_MAX) BIRTH_MAX="$def" ;;
    esac
}

tc_detect_backend() {
    local b
    b=$(uci -q get trafficchart.global.backend 2>/dev/null)
    case "$b" in
        nss|generic) echo "$b"; return ;;
    esac
    if [ -e "$SYSNET/nssifb" ]; then echo nss; else echo generic; fi
}

# ifb device that sqm-scripts created for a WAN device: ifb4<wan> (name
# limited to 15 chars); else the only ifb4* device if there is exactly one.
tc_find_ifb() {
    local wan="$1" cand n found=""
    [ -n "$wan" ] || return 1
    for cand in "ifb4${wan}" "$(echo "ifb4${wan}" | cut -c1-15)"; do
        [ -e "$SYSNET/${cand}" ] && { echo "$cand"; return 0; }
    done
    n=0
    for cand in "$SYSNET"/ifb4*; do
        [ -e "$cand" ] || continue
        n=$((n + 1)); found="${cand##*/}"
    done
    [ "$n" = "1" ] && echo "$found"
}

# bytes of the ROOT qdisc: first "Sent <bytes> bytes ..." line of the PLAIN TEXT
# "tc -s qdisc show" output (tc lists the root first). Deliberately NOT "tc -j":
# JSON support depends on an optional libjson build flag many OpenWrt tc builds
# lack, in which case "-j" silently returns nothing.
tc_qdisc_bytes() {
    local dev="$1" bytes
    [ -n "$dev" ] && [ -e "$SYSNET/${dev}" ] || return 1
    bytes=$(tc -s qdisc show dev "$dev" 2>/dev/null | awk '/^ *Sent /{print $2; exit}')
    case "$bytes" in
        ''|*[!0-9]*) return 1 ;;
    esac
    echo "$bytes"
}

# Cumulative dropped-packet and ECN-mark counters of the shaper qdisc on
# device $1 ("" if the device has none). $2 = backend ("nss" or "generic",
# from tc_resolve's $BACKEND) selects which qdisc in the "tc -s qdisc show"
# output holds the numbers we want:
#   nss      nsstbl (root) has no drops of its own; nssfq_codel (leaf) carries
#            "dropped" (Sent line) and "ecn_mark" (maxpacket line)
#   generic  first qdisc is the root (cake, or htb); if there are fq_codel
#            leaves (htb+fq_codel), their dropped/ecn are summed - cake reports
#            drops on its own root line instead, so that is used as a fallback
# Prints "<dropped> <ecn>", both 0 if the device/qdisc could not be read.
# Shared by luci.trafficchart (live shaper panel) and trafficchart-tc (feeds
# trafficchart-agg, which turns the cumulative numbers into per-bucket deltas
# for the History tab - see hist_close() there).
tc_shaper_drops() {
    local dev="$1" backend="$2"
    [ -n "$dev" ] && [ -e "$SYSNET/${dev}" ] || { echo "0 0 0"; return; }
    tc -s qdisc show dev "$dev" 2>/dev/null | awk -v BACKEND="$backend" '
        function num(v,   n, u) {
            n = v + 0; u = v; sub(/^[0-9.]+/, "", u)
            if (u ~ /^K/) n *= 1024; else if (u ~ /^M/) n *= 1048576; else if (u ~ /^G/) n *= 1073741824
            return n
        }
        /^qdisc / { q++; nm[q] = $2; next }
        /^ *backlog / { bl[q] = num($2); next }
        /^ *Sent / {
            l = $0; gsub(/[(),]/, " ", l); n = split(l, f, " ")
            for (i = 1; i <= n; i++) if (f[i] == "dropped") dr[q] = f[i + 1] + 0
            next
        }
        /maxpacket/ {
            for (i = 1; i < NF; i++) if ($i == "ecn_mark") ecn[q] = $(i + 1) + 0
            next
        }
        END {
            D = 0; E = 0; B = 0
            if (BACKEND == "nss") {
                for (i = 1; i <= q; i++) if (nm[i] == "nssfq_codel") { D = dr[i]; E = ecn[i] }
                if (!D) for (i = 1; i <= q; i++) if (nm[i] == "nsstbl") D = dr[i]
                for (i = 1; i <= q; i++) if (nm[i] == "nssfq_codel" || nm[i] == "nsstbl") B += bl[i]   # leaf + token bucket, same as the live shaper line
            } else {
                for (i = 1; i <= q; i++) if (nm[i] ~ /fq_codel$/) { D += dr[i]; E += ecn[i] }
                if (!D && q >= 1) D = dr[1] + 0   # cake (or a root with no fq_codel leaf): its own drops
                B = bl[1] + 0                     # the root reports what is queued below it
            }
            printf "%d %d %.0f\n", D + 0, E + 0, B + 0
        }'
}

# list helpers: tc_in_list "<list>" item / tc_push LISTVAR item (no duplicates)
tc_in_list() {
    case " $1 " in *" $2 "*) return 0 ;; esac
    return 1
}
tc_push() {
    local var="$1" item="$2" cur
    [ -n "$item" ] || return 0
    eval "cur=\$$var"
    tc_in_list "$cur" "$item" && return 0
    eval "$var=\"\${cur:+\$cur }\$item\""
}

tc_num() {
    case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac
}

# config_foreach callback: every enabled queue counts (multi-WAN)
tc_add_queue() {
    local cfg="$1" enabled iface upload download tx ifb
    config_get enabled "$cfg" enabled 0
    [ "$enabled" = "1" ] || return
    config_get iface "$cfg" interface
    [ -n "$iface" ] || return
    config_get upload "$cfg" upload 0
    config_get download "$cfg" download 0

    tc_push IFACE_LIST "$iface"
    [ -n "$FOUND_IFACE" ] || FOUND_IFACE="$iface"
    FOUND_UPLOAD=$((FOUND_UPLOAD + $(tc_num "$upload")))
    FOUND_DOWNLOAD=$((FOUND_DOWNLOAD + $(tc_num "$download")))

    if [ "$BACKEND" = "nss" ]; then
        # nss-rk.qos strips any VLAN suffix ("eth0.7" -> "eth0") before
        # attaching the egress shaper, so read the qdisc from that same device
        # - not from whatever name is configured in SQM. No-op for eth0, pppoe-wan ...
        tx=$(echo "$iface" | sed 's/\.[0-9]*//g')
        ifb=nssifb
    else
        tx="$iface"
        ifb=$(tc_find_ifb "$iface")
    fi
    tc_push TX_DEVS "$tx"
    if [ -n "$ifb" ] && [ -e "$SYSNET/$ifb" ]; then
        tc_push RX_DEVS "$ifb"
    else
        tc_push RX_RAW "$iface"
    fi
}

tc_resolve() {
    . "${TC_FUNCTIONS:-/lib/functions.sh}"
    BACKEND=$(tc_detect_backend)
    IFACE_LIST=""; FOUND_IFACE=""; FOUND_UPLOAD=0; FOUND_DOWNLOAD=0
    TX_DEVS=""; RX_DEVS=""; RX_RAW=""
    config_load sqm
    config_foreach tc_add_queue queue
    RX_DEV="${RX_DEVS%% *}"
    TX_IFACE="${TX_DEVS%% *}"
    if [ "$BACKEND" = "nss" ]; then
        QTXT="tc qdisc, hw stats"
        SYSNOTE=", unreliable under NSS offload"
    else
        QTXT="tc qdisc"
        SYSNOTE=""
    fi
}

# sums over all devices of each direction -> RX_BYTES/RX_SOURCE, TX_BYTES/TX_SOURCE
tc_read_counters() {
    local d b sum=0 n=0 src=""
    # download/ingress: the shaper lives on the ifb. Packets only reach it AFTER
    # being redirected from the WAN device, so its counters are the correct,
    # already-shaped download rate.
    for d in $RX_DEVS; do
        b=$(tc_qdisc_bytes "$d")
        if [ -n "$b" ]; then
            src="${src:+$src, }${d} (${QTXT})"
        else
            b=$(cat "$SYSNET/${d}/statistics/tx_bytes" 2>/dev/null)
            case "$b" in ''|*[!0-9]*) continue ;; esac
            src="${src:+$src, }${d} (sysfs${SYSNOTE})"
        fi
        sum=$((sum + b)); n=$((n + 1))
    done
    # ingress shaping inactive: this IS the raw/unshaped rate, but it's the best
    # available signal in that case
    for d in $RX_RAW; do
        b=$(cat "$SYSNET/${d}/statistics/rx_bytes" 2>/dev/null)
        case "$b" in ''|*[!0-9]*) continue ;; esac
        src="${src:+$src, }${d} (raw, ingress shaping inactive)"
        sum=$((sum + b)); n=$((n + 1))
    done
    if [ "$n" -gt 0 ]; then RX_BYTES="$sum"; else RX_BYTES=""; fi
    RX_SOURCE="$src"

    sum=0; n=0; src=""
    for d in $TX_DEVS; do
        b=$(tc_qdisc_bytes "$d")
        if [ -n "$b" ]; then
            src="${src:+$src, }${d} (${QTXT})"
        else
            b=$(cat "$SYSNET/${d}/statistics/tx_bytes" 2>/dev/null)
            case "$b" in ''|*[!0-9]*) continue ;; esac
            src="${src:+$src, }${d} (sysfs${SYSNOTE})"
        fi
        sum=$((sum + b)); n=$((n + 1))
    done
    if [ "$n" -gt 0 ]; then TX_BYTES="$sum"; else TX_BYTES=""; fi
    TX_SOURCE="$src"
}
