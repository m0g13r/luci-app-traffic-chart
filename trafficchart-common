#!/bin/sh
# trafficchart-common - shared shaper/device detection (sourced, not executed)
#
# Install as /usr/libexec/trafficchart-common. Sourced by
#   /usr/libexec/rpcd/luci.trafficchart   (page data)
#   /usr/libexec/trafficchart-tc          (link counters for trafficchart-agg)
# so both always look at the same devices (before: two copies "keep in sync").
#
# Usage:
#   . /usr/libexec/trafficchart-common
#   tc_resolve          # who is shaped, and where
#   tc_read_counters    # post-shaping byte counters (needs tc_resolve first)
#   tc_shaper_drops DEV BACKEND   # "<dropped> <ecn> <backlog bytes>" of DEV's qdisc (drops/ECN cumulative, backlog momentary)
#
# tc_resolve sets:
#   BACKEND        nss | generic
#                    nss     NSS hardware offload: nsstbl/nssfq_codel, download
#                            shaper on nssifb
#                    generic stock kernel shaper set up by sqm-scripts: cake or
#                            htb+fq_codel, download shaper on ifb4<wan>
#                  Auto: "nss" if the nssifb device exists, else "generic". To force one:
#                    touch /etc/config/trafficchart
#                    uci set trafficchart.global=trafficchart
#                    uci set trafficchart.global.backend=generic     # or: nss / auto
#                    uci commit trafficchart
#   IFACE_LIST     all ENABLED sqm queue interfaces as configured (space
#                  separated, first one first; several = multi-WAN)
#   FOUND_IFACE    the first of them
#   FOUND_UPLOAD / FOUND_DOWNLOAD   configured SQM rates in kbit/s, SUMMED over
#                  all enabled queues
#   TX_DEVS        devices carrying the upload shaper (NSS: VLAN suffix removed)
#   RX_DEVS        devices carrying the download shaper (ifb / nssifb)
#   RX_RAW         interfaces whose ifb does not exist (ingress shaping inactive):
#                  their raw rx counter is used as the best available signal
#   RX_DEV / TX_IFACE   first entry of RX_DEVS / TX_DEVS (used for the shaper
#                  health line of the page, which shows one device per direction)
#   QTXT SYSNOTE   wording for the counter source strings
#
# tc_read_counters sets:
#   RX_BYTES TX_BYTES   sum over all devices; EMPTY if nothing could be read
#   RX_SOURCE TX_SOURCE human readable origin of the numbers
#
# Settings (/etc/config/trafficchart, section "global"):
#   tc_cfg VAR DEFAULT [TYPE]
#     sets the shell variable VAR from, in this order of priority
#       1. the environment (VAR already set - mainly for testing)
#       2. the UCI option named like the variable in lower case
#          (INTERVAL -> option interval, ATTR_PORTS -> option attr_ports)
#       3. DEFAULT
#     TYPE checks the UCI value; an invalid one is logged (logread -e trafficchart)
#     and DEFAULT is used instead:
#       int     digits only                     num    digits with an optional decimal point
#       list    space separated integers (may be empty)
#       l2      "auto" or an integer of up to 2 digits
#       (none)  any text
#
# Testing only: TC_FUNCTIONS (OpenWrt functions.sh), TC_SYSNET (/sys/class/net)

SYSNET="${TC_SYSNET:-/sys/class/net}"

# Reads the whole section with ONE uci call into CFG_<option> variables. List
# options ("a" "b") are skipped, values are shell-quoted by uci itself.
tc_load_config() {
    [ -n "$TC_CFG_LOADED" ] && return 0
    TC_CFG_LOADED=1
    command -v uci >/dev/null 2>&1 || return 0
    local opt val
    # Avoid eval entirely: validate the option name, then assign only the
    # explicitly supported configuration variables.
    for opt in interval profile tc_stats adapt_interval interval_max persist_dir persist_mount persist_sec persist_timeout \
        hist_sec hist_keep hist_hour_keep hist_day_keep bulk_bytes app_hold v6_reresolve unresolved_max backend \
        attr_win attr_tol attr_topapps attr_totals attr_skip_ports attr_ports attr_min attr_share attr_max_apps \
        attr_max_devices l2_overhead l2_init l2_candidates cal_tol cal_win cal_keep cal_min cal_pctl cal_max_pkt \
        cal_min_pkts host_max un_win un_win_rx un_win_long app_max mx_max pair_max tbl_idle_long tbl_idle_short \
        rate_win tooltips tooltip_every hosts_refresh_sec gua_refresh_sec gone_grace birth_max; do
        val=$(uci -q get "trafficchart.global.$opt" 2>/dev/null) || continue
        case "$opt" in
            interval) INTERVAL="$val" ;; profile) PROFILE="$val" ;;
            tc_stats) TC_STATS="$val" ;; adapt_interval) ADAPT_INTERVAL="$val" ;;
            interval_max) INTERVAL_MAX="$val" ;; persist_dir) PERSIST_DIR="$val" ;;
            persist_mount) PERSIST_MOUNT="$val" ;; persist_sec) PERSIST_SEC="$val" ;;
            persist_timeout) PERSIST_TIMEOUT="$val" ;; hist_sec) HIST_SEC="$val" ;;
            hist_keep) HIST_KEEP="$val" ;; hist_hour_keep) HIST_HOUR_KEEP="$val" ;;
            hist_day_keep) HIST_DAY_KEEP="$val" ;; bulk_bytes) BULK_BYTES="$val" ;;
            app_hold) APP_HOLD="$val" ;; v6_reresolve) V6_RERESOLVE="$val" ;;
            unresolved_max) UNRESOLVED_MAX="$val" ;; backend) BACKEND="$val" ;;
            attr_win) ATTR_WIN="$val" ;; attr_tol) ATTR_TOL="$val" ;;
            attr_topapps) ATTR_TOPAPPS="$val" ;; attr_totals) ATTR_TOTALS="$val" ;;
            attr_skip_ports) ATTR_SKIP_PORTS="$val" ;; attr_ports) ATTR_PORTS="$val" ;;
            attr_min) ATTR_MIN="$val" ;; attr_share) ATTR_SHARE="$val" ;;
            attr_max_apps) ATTR_MAX_APPS="$val" ;; attr_max_devices) ATTR_MAX_DEVICES="$val" ;;
            l2_overhead) L2_OVERHEAD="$val" ;; l2_init) L2_INIT="$val" ;;
            l2_candidates) L2_CANDIDATES="$val" ;; cal_tol) CAL_TOL="$val" ;;
            cal_win) CAL_WIN="$val" ;; cal_keep) CAL_KEEP="$val" ;;
            cal_min) CAL_MIN="$val" ;; cal_pctl) CAL_PCTL="$val" ;;
            cal_max_pkt) CAL_MAX_PKT="$val" ;; cal_min_pkts) CAL_MIN_PKTS="$val" ;;
            host_max) HOST_MAX="$val" ;; un_win) UN_WIN="$val" ;;
            un_win_rx) UN_WIN_RX="$val" ;; un_win_long) UN_WIN_LONG="$val" ;;
            app_max) APP_MAX="$val" ;; mx_max) MX_MAX="$val" ;;
            pair_max) PAIR_MAX="$val" ;; tbl_idle_long) TBL_IDLE_LONG="$val" ;;
            tbl_idle_short) TBL_IDLE_SHORT="$val" ;; rate_win) RATE_WIN="$val" ;;
            tooltips) TOOLTIPS="$val" ;; tooltip_every) TOOLTIP_EVERY="$val" ;;
            hosts_refresh_sec) HOSTS_REFRESH_SEC="$val" ;; gua_refresh_sec) GUA_REFRESH_SEC="$val" ;;
            gone_grace) GONE_GRACE="$val" ;; birth_max) BIRTH_MAX="$val" ;;
        esac
    done
}

tc_cfg_valid() {
    local t
    case "$2" in
        int)  case "$3" in ''|*[!0-9]*) return 1 ;; esac ;;
        num)  case "$3" in ''|*[!0-9.]*|.*|*.|*.*.*) return 1 ;; esac ;;
        list) for t in $3; do case "$t" in ''|*[!0-9]*) return 1 ;; esac; done ;;
        l2)   case "$3" in auto|[0-9]|[0-9][0-9]) ;; *) return 1 ;; esac ;;
    esac
    return 0
}

tc_cfg() {
    local var="$1" def="$2" type="$3" isset= val=
    tc_load_config
    case "$var" in
        INTERVAL) isset=${INTERVAL+x}; val="${INTERVAL-}" ;;
        PROFILE) isset=${PROFILE+x}; val="${PROFILE-}" ;;
        TC_STATS) isset=${TC_STATS+x}; val="${TC_STATS-}" ;;
        ADAPT_INTERVAL) isset=${ADAPT_INTERVAL+x}; val="${ADAPT_INTERVAL-}" ;;
        INTERVAL_MAX) isset=${INTERVAL_MAX+x}; val="${INTERVAL_MAX-}" ;;
        PERSIST_DIR) isset=${PERSIST_DIR+x}; val="${PERSIST_DIR-}" ;;
        PERSIST_MOUNT) isset=${PERSIST_MOUNT+x}; val="${PERSIST_MOUNT-}" ;;
        PERSIST_SEC) isset=${PERSIST_SEC+x}; val="${PERSIST_SEC-}" ;;
        PERSIST_TIMEOUT) isset=${PERSIST_TIMEOUT+x}; val="${PERSIST_TIMEOUT-}" ;;
        HIST_SEC) isset=${HIST_SEC+x}; val="${HIST_SEC-}" ;;
        HIST_KEEP) isset=${HIST_KEEP+x}; val="${HIST_KEEP-}" ;;
        HIST_HOUR_KEEP) isset=${HIST_HOUR_KEEP+x}; val="${HIST_HOUR_KEEP-}" ;;
        HIST_DAY_KEEP) isset=${HIST_DAY_KEEP+x}; val="${HIST_DAY_KEEP-}" ;;
        BULK_BYTES) isset=${BULK_BYTES+x}; val="${BULK_BYTES-}" ;;
        APP_HOLD) isset=${APP_HOLD+x}; val="${APP_HOLD-}" ;;
        V6_RERESOLVE) isset=${V6_RERESOLVE+x}; val="${V6_RERESOLVE-}" ;;
        UNRESOLVED_MAX) isset=${UNRESOLVED_MAX+x}; val="${UNRESOLVED_MAX-}" ;;
        BACKEND) isset=${BACKEND+x}; val="${BACKEND-}" ;;
        ATTR_WIN) isset=${ATTR_WIN+x}; val="${ATTR_WIN-}" ;;
        ATTR_TOL) isset=${ATTR_TOL+x}; val="${ATTR_TOL-}" ;;
        ATTR_TOPAPPS) isset=${ATTR_TOPAPPS+x}; val="${ATTR_TOPAPPS-}" ;;
        ATTR_TOTALS) isset=${ATTR_TOTALS+x}; val="${ATTR_TOTALS-}" ;;
        ATTR_SKIP_PORTS) isset=${ATTR_SKIP_PORTS+x}; val="${ATTR_SKIP_PORTS-}" ;;
        ATTR_PORTS) isset=${ATTR_PORTS+x}; val="${ATTR_PORTS-}" ;;
        ATTR_MIN) isset=${ATTR_MIN+x}; val="${ATTR_MIN-}" ;;
        ATTR_SHARE) isset=${ATTR_SHARE+x}; val="${ATTR_SHARE-}" ;;
        ATTR_MAX_APPS) isset=${ATTR_MAX_APPS+x}; val="${ATTR_MAX_APPS-}" ;;
        ATTR_MAX_DEVICES) isset=${ATTR_MAX_DEVICES+x}; val="${ATTR_MAX_DEVICES-}" ;;
        L2_OVERHEAD) isset=${L2_OVERHEAD+x}; val="${L2_OVERHEAD-}" ;;
        L2_INIT) isset=${L2_INIT+x}; val="${L2_INIT-}" ;;
        L2_CANDIDATES) isset=${L2_CANDIDATES+x}; val="${L2_CANDIDATES-}" ;;
        CAL_TOL) isset=${CAL_TOL+x}; val="${CAL_TOL-}" ;;
        CAL_WIN) isset=${CAL_WIN+x}; val="${CAL_WIN-}" ;;
        CAL_KEEP) isset=${CAL_KEEP+x}; val="${CAL_KEEP-}" ;;
        CAL_MIN) isset=${CAL_MIN+x}; val="${CAL_MIN-}" ;;
        CAL_PCTL) isset=${CAL_PCTL+x}; val="${CAL_PCTL-}" ;;
        CAL_MAX_PKT) isset=${CAL_MAX_PKT+x}; val="${CAL_MAX_PKT-}" ;;
        CAL_MIN_PKTS) isset=${CAL_MIN_PKTS+x}; val="${CAL_MIN_PKTS-}" ;;
        HOST_MAX) isset=${HOST_MAX+x}; val="${HOST_MAX-}" ;;
        UN_WIN) isset=${UN_WIN+x}; val="${UN_WIN-}" ;;
        UN_WIN_RX) isset=${UN_WIN_RX+x}; val="${UN_WIN_RX-}" ;;
        UN_WIN_LONG) isset=${UN_WIN_LONG+x}; val="${UN_WIN_LONG-}" ;;
        APP_MAX) isset=${APP_MAX+x}; val="${APP_MAX-}" ;;
        MX_MAX) isset=${MX_MAX+x}; val="${MX_MAX-}" ;;
        PAIR_MAX) isset=${PAIR_MAX+x}; val="${PAIR_MAX-}" ;;
        TBL_IDLE_LONG) isset=${TBL_IDLE_LONG+x}; val="${TBL_IDLE_LONG-}" ;;
        TBL_IDLE_SHORT) isset=${TBL_IDLE_SHORT+x}; val="${TBL_IDLE_SHORT-}" ;;
        RATE_WIN) isset=${RATE_WIN+x}; val="${RATE_WIN-}" ;;
        TOOLTIPS) isset=${TOOLTIPS+x}; val="${TOOLTIPS-}" ;;
        TOOLTIP_EVERY) isset=${TOOLTIP_EVERY+x}; val="${TOOLTIP_EVERY-}" ;;
        HOSTS_REFRESH_SEC) isset=${HOSTS_REFRESH_SEC+x}; val="${HOSTS_REFRESH_SEC-}" ;;
        GUA_REFRESH_SEC) isset=${GUA_REFRESH_SEC+x}; val="${GUA_REFRESH_SEC-}" ;;
        GONE_GRACE) isset=${GONE_GRACE+x}; val="${GONE_GRACE-}" ;;
        BIRTH_MAX) isset=${BIRTH_MAX+x}; val="${BIRTH_MAX-}" ;;
        *) return 0 ;;
    esac
    [ -n "$isset" ] || return 0
    if tc_cfg_valid "$var" "$type" "$val"; then return 0; fi
    logger -t trafficchart "config: invalid value '$val' - using default '$def'" 2>/dev/null
    case "$var" in
